# Copy to apps/web/.env for local development

# Set to true to force demo fixtures even if Supabase is configured
VITE_DEMO_MODE=true

# Supabase (leave empty to run fully in demo mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site URL (used for canonical / sitemap generation later)
VITE_SITE_URL=https://abone-consulting.eu
